[Unit]
# ROUND8-OPS-07 (+ REL-2-14): canonical, hardened systemd unit.
#
# This file is the operator-installable systemd unit. The inline
# code block in `DEPLOYMENT.md` is a rendering of these directives.
#
# That agreement is now actually enforced, by doc-lint tier-1b
# (`scripts/ci/doc-lint.sh`): for Type / ExecStart / ExecReload /
# NotifyAccess / KillMode / KillSignal / Restart / User / Group, a
# value stated in DEPLOYMENT.md must match the value here. Until S47
# this header asserted that enforcement existed when it did not —
# tier-1 greps one stale ExecStart pattern and nothing more — which
# is how `Type=notify` (with no sd_notify anywhere) and an `-USR1`
# ExecReload both shipped while the docs said otherwise.
#
# Drop-ins:
#   - Non-XDP deploys: install
#     `/etc/systemd/system/expressgateway.service.d/no-xdp.conf`
#     with
#         [Service]
#         RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#         CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#         AmbientCapabilities=CAP_NET_BIND_SERVICE
#     to drop AF_NETLINK + CAP_NET_ADMIN + CAP_BPF.
#   - Hosts without bpffs at /sys/fs/bpf: add a `mount -t bpf bpffs
#     /sys/fs/bpf` to a precondition unit; this unit's
#     `RequiresMountsFor=` will refuse to start otherwise.
#
# Hardening: `systemd-analyze security packaging/expressgateway.service`
# must score below 1.5 ("OK"); CI gate `systemd-analyze-security`
# enforces.

Description=ExpressGateway L4/L7 load balancer
Documentation=https://github.com/proto/ExpressGateway/blob/main/README.md
After=network-online.target
Wants=network-online.target

[Service]
# REL-02 (S47): was `Type=notify` + `NotifyAccess=main`, but NOTHING in the workspace ever
# calls sd_notify — `rg -i 'sd_notify|libsystemd|NOTIFY_SOCKET'` over crates/ returns nothing.
# systemd therefore waited for a READY=1 that could never arrive, hit the default 90 s
# TimeoutStartSec, SIGKILLed a perfectly healthy gateway, and `Restart=on-failure` did it again
# forever. `simple` is what DEPLOYMENT.md documents. (`Type=exec` would additionally catch a
# failed exec as a start failure; deferred as a separate change since it moves the documented
# contract.) Restore `notify` only together with a real sd_notify call, which would also let
# WatchdogSec below be un-commented.
Type=simple
User=expressgateway
Group=expressgateway
ExecStart=/usr/local/bin/expressgateway /etc/expressgateway/lb.toml
# REL-05 (S47): was `-USR1`, which is the CERT reload. `systemctl reload` means "re-read
# config" to every operator, and both DEPLOYMENT.md:55 and RUNBOOK.md:210 quote this line as
# `-HUP`. The unit was the outlier: a `systemctl reload` after a backend edit logged
# "TLS cert reload succeeded" and applied no config change at all.
# Cert rotation stays on SIGUSR1 — send it directly (`kill -USR1 $MAINPID`), as RUNBOOK documents.
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s

# --- Capabilities (SEC-2-11) ---
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_BPF
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_BPF

# --- Round 8 hardening (OPS-07) ---

# Syscall filter. @system-service is a curated set; ~@privileged etc
# strip everything we never call.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @cpu-emulation @keyring @obsolete @mount @raw-io
SystemCallArchitectures=native

# Address family restriction.
# Default set covers UNIX (admin socket) + IPv4/IPv6 (listeners) +
# AF_NETLINK (XDP attach / link query). Operators running without XDP
# should drop AF_NETLINK in a drop-in.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Namespace + privilege restrictions.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
RemoveIPC=true

# Kernel protections.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true

# /tmp + /dev isolation.
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
# PrivateUsers=true is incompatible with CAP_BPF on some kernels;
# leave default (false).

# Memory.
MemoryDenyWriteExecute=true
UMask=0077

# FS write surface.
ReadOnlyPaths=/
ReadWritePaths=/var/log/expressgateway /run/expressgateway

# Mount preconditions: refuse to start if bpffs is not mounted at
# /sys/fs/bpf (XDP loader pins its maps there; cross-references
# ROUND8-L4-11 runtime statfs check inside the loader).
RequiresMountsFor=/sys/fs/bpf

# Resource limits.
LimitNOFILE=1048576
LimitMEMLOCK=infinity

# Watchdog: requires sd_notify(WATCHDOG=1) from the process. Wave 2
# wires the heartbeat task; until then the unit may flap on
# WatchdogSec triggers, so this is commented out and re-enabled by
# the same Wave 2 commit that adds the heartbeat.
#WatchdogSec=15s

[Install]
WantedBy=multi-user.target
